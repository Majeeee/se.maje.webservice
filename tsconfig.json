{
  "compilerOptions": {
    // Filstruktur
    "rootDir": "./src",
    "outDir": "./dist",

    // Miljö
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "types": ["node"],
    "resolveJsonModule": true,

    // Utdata
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Striktare typkontroll
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,

    // Rekommenderade options
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
